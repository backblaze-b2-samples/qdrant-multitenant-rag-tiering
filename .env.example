# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# The region in your bucket's S3 endpoint, e.g. s3.<region>.backblazeb2.com.
# The endpoint itself is derived from it, so there is no endpoint variable.
B2_REGION=your-b2-region

# Optional: public base URL for objects, when the bucket is public.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.<region>.backblazeb2.com

# Example of what filled-in values look like (fake, for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K005EXAMPLE_NOT_A_REAL_APP_KEY
# B2_BUCKET_NAME=my-rag-tiering-bucket
# B2_REGION=<region from your bucket endpoint>

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# Docker Compose passes it as a build argument (Next.js inlines it at build time).
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Hot tier and tiering policy (all optional; defaults shown) -------------
# Qdrant node for hot tenants. Docker Compose sets http://qdrant:6333.
# QDRANT_URL=http://localhost:6333
# Key prefix for everything the app writes (corpus, snapshots, reports).
# RAG_PREFIX=rag/
# Any fastembed text model; its vector size is recorded in every snapshot manifest.
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# A hot tenant idle this long (no query or write) is a parking candidate. 7 days.
# TIERING_IDLE_SECONDS=604800
# Background sweep cadence in seconds; 0 disables the sweep.
# TIERING_SWEEP_INTERVAL_SECONDS=300
# Multipart part size for streaming snapshots to B2 (minimum 5 MiB).
# SNAPSHOT_PART_SIZE_BYTES=8388608
# Allow /snapshots/prune to delete superseded snapshots (each call also needs apply=true).
# SNAPSHOT_PRUNE_ENABLED=false
